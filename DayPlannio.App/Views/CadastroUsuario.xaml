<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DayPlannio.App.Views"
    x:Class="DayPlannio.App.Views.CadastroUsuario"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="*">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Padding="20">

                <Border
                    BackgroundColor="{StaticResource White}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 15"
                    Padding="25">

                    <VerticalStackLayout
                        VerticalOptions="Center"
                        Spacing="8">

                        <Image
                            Source="logo.png"
                            HeightRequest="80"
                            HorizontalOptions="Center"
                            Margin="0,0,0,5"/>

                        <Label Text="Nome"
                               FontSize="14"
                               TextColor="{StaticResource LabelColor}"/>

                        <Border BackgroundColor="#EBEBEB"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10">

                            <Entry Placeholder="Digite seu nome completo"
                                   Text="{Binding Nome}"/>
                        </Border>

                        <Label Text="E-mail"
                               FontSize="14"
                               TextColor="{StaticResource LabelColor}"/>

                        <Border BackgroundColor="#EBEBEB"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10">

                            <Entry Placeholder="Digite seu e-mail"
                                   Keyboard="Email"
                                   Text="{Binding Email}"/>
                        </Border>

                        <Label Text="Senha"
                               FontSize="14"
                               TextColor="{StaticResource LabelColor}"/>

                        <Border BackgroundColor="#EBEBEB"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10">

                            <Grid ColumnDefinitions="*,40">

                                <Entry Grid.Column="0"
                                   Placeholder="Crie uma senha"
                                   IsPassword="{Binding SenhaOculta}"
                                   Text="{Binding Senha}"
                                   BackgroundColor="Transparent"/>

                                <ImageButton Grid.Column="1"
                                         Source="{Binding IconeSenha}"
                                         HeightRequest="16"
                                         WidthRequest="16"
                                         MinimumHeightRequest="0"
                                         MinimumWidthRequest="0"
                                         Padding="0"
                                         Margin="10,0,0,0"
                                         VerticalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Command="{Binding MostrarOcultarSenhaCommand}"/>
                            </Grid>
                        </Border>

                        <Label Text="Confirmar Senha"
                               FontSize="14"
                               TextColor="{StaticResource LabelColor}"/>

                        <Border BackgroundColor="#EBEBEB"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10">

                            <Grid ColumnDefinitions="*,40">

                                <Entry Grid.Column="0"
                                       Placeholder="Confirme sua senha"
                                       IsPassword="{Binding ConfirmarSenhaOculta}"
                                       Text="{Binding ConfirmarSenha}"
                                       BackgroundColor="Transparent"/>

                                <ImageButton Grid.Column="1"
                                             Source="{Binding IconeConfirmarSenha}"
                                             HeightRequest="16"
                                             WidthRequest="16"
                                             MinimumHeightRequest="0"
                                             MinimumWidthRequest="0"
                                             Padding="0"
                                             Margin="10,0,0,0"
                                             VerticalOptions="Center"
                                             BackgroundColor="Transparent"
                                             Command="{Binding MostrarOcultarConfirmarSenhaCommand}"/>
                            </Grid>
                        </Border>

                        <VerticalStackLayout Spacing="6" Margin="0,5,0,0">

                            <HorizontalStackLayout Spacing="6">
                                <Label Text="●"
                                       FontSize="12"
                                       TextColor="#CFCFCF">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding ReqTamanho}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="#006260"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="Mínimo 6 caracteres"
                                       TextColor="Gray"
                                       FontSize="12"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="6">
                                <Label Text="●"
                                       FontSize="12"
                                       TextColor="#CFCFCF">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding ReqMaiusculo}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="#006260"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="Uma letra maiúscula"
                                       TextColor="Gray"
                                       FontSize="12"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="6">
                                <Label Text="●"
                                       FontSize="12"
                                       TextColor="#CFCFCF">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding ReqMinusculo}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="#006260"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="Uma letra minúscula"
                                       TextColor="Gray"
                                       FontSize="12"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="6">
                                <Label Text="●"
                                       FontSize="12"
                                       TextColor="#CFCFCF">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding ReqEspecial}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="#006260"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="Um caractere especial"
                                       TextColor="Gray"
                                       FontSize="12"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="6">
                                <Label Text="●"
                                       FontSize="12"
                                       TextColor="#CFCFCF">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding ReqNumero}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="#006260"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="Um número"
                                       TextColor="Gray"
                                       FontSize="12"/>
                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                        <Label Text="Telefone (Opcional)"
                               FontSize="14"
                               TextColor="{StaticResource LabelColor}"/>

                        <Border BackgroundColor="#EBEBEB"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10">

                            <Entry Placeholder="Digite seu telefone"
                                   Keyboard="Telephone"
                                   Text="{Binding Telefone}"/>
                        </Border>

                        <Label Text="{Binding ErroMensagem}"
                               TextColor="Red"
                               IsVisible="{Binding ErroVisivel}"/>

                        <Button Text="Cadastrar"
                                TextColor="White"
                                CornerRadius="20"
                                Command="{Binding CadastrarCommand}">

                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#006260" Offset="0.0"/>
                                    <GradientStop Color="#1E7C7A" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Button.Background>

                        </Button>

                        <Label Text="OU"
                               HorizontalOptions="Center"
                               TextColor="#6E7978"
                               FontSize="12"
                               Margin="0,10,0,0"/>

                        <HorizontalStackLayout HorizontalOptions="Center"
                                               Spacing="5">

                            <Label Text="Já possui uma conta?"
                                   TextColor="#3E4948"
                                   FontSize="13"/>

                            <Label Text="Faça Login"
                                   TextColor="{StaticResource PrimaryColor}"
                                   FontAttributes="Bold"
                                   FontSize="13">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LoginCommand}"/>
                                </Label.GestureRecognizers>

                            </Label>

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>