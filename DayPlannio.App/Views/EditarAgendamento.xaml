<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:DayPlannio.App.Views"
             x:Class="DayPlannio.App.Views.EditarAgendamento"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False"
             Title="Editar Agendamento">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout>

                <Grid Padding="20,20,20,0"
                      VerticalOptions="Center">

                    <Label Text="Editar Agendamento"
                           FontSize="17"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{StaticResource PrimaryColor}"/>

                    <ImageButton Source="icon_seta_esquerda.png"
                                 WidthRequest="10"
                                 HeightRequest="10"
                                 Padding="2"
                                 BackgroundColor="Transparent"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Center"
                                 Command="{Binding VoltarCommand}"/>

                </Grid>

                <VerticalStackLayout Padding="20,20,20,0">

                    <Label Text="Edite seu Agendamento"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#181C1C"/>

                    <Label Text="Atualize as informações do agendamento."
                           FontSize="13"
                           TextColor="#3E4948"/>

                </VerticalStackLayout>

                <VerticalStackLayout Padding="20"
                                     Spacing="15">

                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15"
                            Padding="20">

                        <VerticalStackLayout Spacing="12">

                            <Label Text="CLIENTE"
                                   FontSize="11"
                                   TextColor="#3E4948"/>

                            <Border BackgroundColor="#EBEBEB"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,0">

                                <Grid ColumnDefinitions="*,Auto">

                                    <Label Text="{Binding ClienteSelecionado.Nome}"
                                           FontSize="14"
                                           TextColor="#555"
                                           VerticalOptions="Center"/>

                                    <Image Grid.Column="1"
                                           Source="icon_seta_baixo.png"
                                           WidthRequest="12"
                                           HeightRequest="12"
                                           VerticalOptions="Center"/>

                                    <Picker ItemsSource="{Binding Clientes}"
                                            SelectedItem="{Binding ClienteSelecionado}"
                                            ItemDisplayBinding="{Binding Nome}"
                                            Opacity="0.01"
                                            HeightRequest="45"/>

                                </Grid>

                            </Border>

                            <Label Text="TIPO DE SERVIÇO"
                                   FontSize="11"
                                   TextColor="#3E4948"
                                   Margin="0,10,0,0"/>

                            <Border BackgroundColor="#EBEBEB"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,0">

                                <Grid ColumnDefinitions="*,Auto">

                                    <Label Text="{Binding ServicoSelecionado.Tipo}"
                                           FontSize="14"
                                           TextColor="#555"
                                           VerticalOptions="Center"/>

                                    <Image Grid.Column="1"
                                           Source="icon_seta_baixo.png"
                                           WidthRequest="12"
                                           HeightRequest="12"
                                           VerticalOptions="Center"/>

                                    <Picker ItemsSource="{Binding Servicos}"
                                            SelectedItem="{Binding ServicoSelecionado}"
                                            ItemDisplayBinding="{Binding Tipo}"
                                            Opacity="0.01"
                                            HeightRequest="45"/>

                                </Grid>

                            </Border>

                        </VerticalStackLayout>

                    </Border>

                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15"
                            Padding="20">

                        <VerticalStackLayout Spacing="12">

                            <Label Text="DATA DO ATENDIMENTO"
                                   FontSize="11"
                                   TextColor="#3E4948"/>

                            <Border BackgroundColor="#EBEBEB"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,0">

                                <Grid ColumnDefinitions="*,Auto">

                                    <Label Text="{Binding DataSelecionada, StringFormat='{0:dd/MM/yyyy}'}"
                                           FontSize="14"
                                           TextColor="#555"
                                           VerticalOptions="Center"/>

                                    <DatePicker Date="{Binding DataSelecionada}"
                                                MinimumDate="{Binding DataMinima}"
                                                Opacity="0.01"
                                                HeightRequest="45"/>

                                </Grid>

                            </Border>

                            <Label Text="HORÁRIO"
                                   FontSize="11"
                                   TextColor="#3E4948"
                                   Margin="0,10,0,0"/>

                            <Border BackgroundColor="#EBEBEB"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,0">

                                <Grid ColumnDefinitions="*,Auto">

                                    <Label Text="{Binding LblHorario}"
                                           FontSize="14"
                                           TextColor="#555"
                                           VerticalOptions="Center"/>

                                    <TimePicker Time="{Binding HorarioSelecionado}"
                                                Format="HH:mm"
                                                Opacity="0.01"
                                                HeightRequest="45"/>

                                </Grid>

                            </Border>

                        </VerticalStackLayout>

                    </Border>

                    <Border BackgroundColor="#F0FAFA"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15"
                            Padding="20">

                        <VerticalStackLayout Spacing="10">

                            <HorizontalStackLayout Spacing="8">
                                <Image Source="icon_nota.png" WidthRequest="18" HeightRequest="18"/>
                                <Label Text="Valores e Custos" FontSize="14" FontAttributes="Bold" TextColor="#006260"/>
                            </HorizontalStackLayout>

                            <Label Text="VALOR COBRADO"
                                   FontSize="11"
                                   TextColor="#3E4948"
                                   Margin="0,8,0,0"/>

                            <Border BackgroundColor="#EBEBEB"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,0">

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">

                                    <Label Text="R$" FontSize="16" FontAttributes="Bold" TextColor="#006260" VerticalOptions="Center"/>

                                    <Entry Grid.Column="1"
                                       Text="{Binding Valor}"
                                       Keyboard="Numeric"
                                       HeightRequest="45"
                                       TextColor="#006260"
                                       BackgroundColor="Transparent"/>

                                </Grid>
                            </Border>

                            <Label Text="CUSTO DE MATERIAL"
                                   FontSize="11"
                                   TextColor="#3E4948"
                                   Margin="0,10,0,0"/>

                            <Border BackgroundColor="#EBEBEB"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,0">

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="R$" FontSize="16" FontAttributes="Bold" TextColor="#854627" VerticalOptions="Center"/>

                                    <Entry Grid.Column="1"
                                       Text="{Binding Custo}"
                                       Keyboard="Numeric"
                                       HeightRequest="45"
                                       TextColor="#854627"
                                       BackgroundColor="Transparent"/>

                                </Grid>
                            </Border>

                        </VerticalStackLayout>

                    </Border>

                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15"
                            Padding="20">

                        <VerticalStackLayout Spacing="10">

                            <Label Text="OBSERVAÇÕES ADICIONAIS"
                                   FontSize="11"
                                   TextColor="#3E4948"/>

                            <Border BackgroundColor="#EBEBEB"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">

                                <Editor Text="{Binding Observacoes}"
                                        HeightRequest="100"
                                        BackgroundColor="Transparent"/>

                            </Border>

                        </VerticalStackLayout>

                    </Border>

                    <Label Text="{Binding ErroMensagem}"
                           TextColor="#BA1A1A"
                           IsVisible="{Binding ErroVisivel}"/>

                    <Button Text="Salvar Alterações"
                            TextColor="White"
                            CornerRadius="25"
                            HeightRequest="50"
                            Command="{Binding SalvarCommand}">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,0">
                                <GradientStop Color="#006260" Offset="0"/>
                                <GradientStop Color="#1E7C7A" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>

                    </Button>

                    <Button Text="Cancelar"
                            BackgroundColor="Transparent"
                            TextColor="Gray"
                            Command="{Binding CancelarCommand}"/>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <views:CustomTabBar Grid.Row="1"/>

    </Grid>

</ContentPage>