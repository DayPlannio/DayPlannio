<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DayPlannio.App.Views"
    x:Class="DayPlannio.App.Views.Financeiro"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#EDEDED">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Padding="18,20,18,120">

                <Label
                    Text="Financeiro"
                    HorizontalOptions="Center"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#006260"/>

                <Border
                    Margin="0,22,0,0"
                    Padding="6"
                    BackgroundColor="#D7D7D7"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22">

                    <Grid ColumnDefinitions="*,*,*">

                        <Border
                            Grid.Column="0"
                            BackgroundColor="{Binding CorFundoDiario}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">

                            <Label
                                Text="Diário"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Padding="0,12"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{Binding CorTextoDiario}"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelecionarPeriodoCommand}"
                                    CommandParameter="diario"/>
                            </Border.GestureRecognizers>

                        </Border>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="{Binding CorFundoSemanal}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">

                            <Label
                                Text="Semanal"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Padding="0,12"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{Binding CorTextoSemanal}"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelecionarPeriodoCommand}"
                                    CommandParameter="semanal"/>
                            </Border.GestureRecognizers>

                        </Border>

                        <Border
                            Grid.Column="2"
                            BackgroundColor="{Binding CorFundoMensal}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">

                            <Label
                                Text="Mensal"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Padding="0,12"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{Binding CorTextoMensal}"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelecionarPeriodoCommand}"
                                    CommandParameter="mensal"/>
                            </Border.GestureRecognizers>

                        </Border>

                    </Grid>

                </Border>

                <Border
                    Margin="0,18,0,0"
                    Padding="5"
                    BackgroundColor="#D7D7D7"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22">

                    <Grid ColumnDefinitions="*,*">

                        <Border
                            Grid.Column="0"
                            BackgroundColor="{Binding CorFundoMovimentacoes}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">

                            <Label
                                Text="Movimentações"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Padding="0,12"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{Binding CorTextoMovimentacoes}"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding MostrarMovimentacoesCommand}"/>
                            </Border.GestureRecognizers>

                        </Border>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="{Binding CorFundoResumo}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">

                            <Label
                                Text="Resumo"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Padding="0,12"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{Binding CorTextoResumo}"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding MostrarResumoCommand}"/>
                            </Border.GestureRecognizers>

                        </Border>

                    </Grid>

                </Border>

                <VerticalStackLayout
                    IsVisible="{Binding AbaResumoVisivel}"
                    Spacing="22">

                    <Border
                        Margin="0,22,0,0"
                        Padding="22,20"
                        BackgroundColor="#006260"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">

                        <VerticalStackLayout Spacing="14">

                            <Label
                                Text="SALDO TOTAL"
                                FontSize="15"
                                TextColor="#BFE6E4"/>

                            <Label
                                Text="{Binding LucroLiquido}"
                                FontSize="34"
                                FontAttributes="Bold"
                                TextColor="White"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Margin="6,0"
                        Padding="22,22"
                        BackgroundColor="#F5F5F5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="20">

                            <Label
                                Text="LUCRO BRUTO"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#454545"/>

                            <Label
                                Text="{Binding LucroBruto}"
                                FontSize="26"
                                FontAttributes="Bold"
                                TextColor="#1E1E1E"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Margin="6,0"
                        Padding="22,22"
                        BackgroundColor="#F5F5F5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="20">

                            <Label
                                Text="GASTOS TOTAIS"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#454545"/>

                            <Label
                                Text="{Binding GastosTotais}"
                                FontSize="26"
                                FontAttributes="Bold"
                                TextColor="#1E1E1E"/>

                        </VerticalStackLayout>

                    </Border>

                    <Button
                        Text="Gerar Relatório PDF"
                        Margin="34,0"
                        HeightRequest="50"
                        CornerRadius="25"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="White"
                        Command="{Binding GerarPdfCommand}">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#006260" Offset="0"/>
                                <GradientStop Color="#1B8A86" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>

                    </Button>

                </VerticalStackLayout>

                <VerticalStackLayout
                    IsVisible="{Binding AbaMovimentacoesVisivel}"
                    Spacing="20">

                    <Border
                        Margin="0,22,0,0"
                        Padding="18"
                        BackgroundColor="#006260"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">

                        <VerticalStackLayout Spacing="18">

                            <VerticalStackLayout Spacing="10">

                                <Label
                                    Text="SALDO DOS SERVIÇOS"
                                    FontSize="14"
                                    TextColor="#BFE6E4"/>

                                <Label
                                    Text="{Binding SaldoServicos}"
                                    FontSize="32"
                                    FontAttributes="Bold"
                                    TextColor="White"/>

                            </VerticalStackLayout>

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="16">

                                <Border
                                    Grid.Column="0"
                                    Padding="14"
                                    BackgroundColor="#1D7A77"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">

                                    <VerticalStackLayout Spacing="10">

                                        <Label
                                            Text="Valor Cobrado"
                                            FontSize="12"
                                            TextColor="#E9FFFF"/>

                                        <Label
                                            Text="{Binding ValorCobrado}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            TextColor="#BFFFE7"/>

                                    </VerticalStackLayout>

                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="14"
                                    BackgroundColor="#1D7A77"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">

                                    <VerticalStackLayout Spacing="10">

                                        <Label
                                            Text="Custos"
                                            FontSize="12"
                                            TextColor="#E9FFFF"/>

                                        <Label
                                            Text="{Binding CustoServicos}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            TextColor="#FFBE9B"/>

                                    </VerticalStackLayout>

                                </Border>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                    <Label
                        Text="Entradas e Saídas"
                        Margin="10,0,0,0"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#1E1E1E"/>

                    <CollectionView
                        ItemsSource="{Binding Registros}"
                        SelectionMode="None"
                        MinimumHeightRequest="100">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout
                                Orientation="Vertical"
                                ItemSpacing="16"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    Padding="16,14"
                                    BackgroundColor="#F8F8F8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">

                                    <Grid
                                        RowDefinitions="Auto,Auto"
                                        ColumnDefinitions="*,Auto">

                                        <Label
                                            Text="{Binding Descricao}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="#1E1E1E"/>

                                        <HorizontalStackLayout
                                            Grid.Column="1"
                                            Spacing="10">

                                            <ImageButton
                                                Source="icon_editar.png"
                                                HeightRequest="16"
                                                WidthRequest="16"
                                                MinimumHeightRequest="0"
                                                MinimumWidthRequest="0"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                Margin="10,0,0,0"
                                                VerticalOptions="Center"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}"
                                                CommandParameter="{Binding .}"/>

                                            <ImageButton
                                                Source="icon_excluir.png"
                                                HeightRequest="16"
                                                WidthRequest="16"
                                                MinimumHeightRequest="0"
                                                MinimumWidthRequest="0"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                Margin="10,0,0,0"
                                                VerticalOptions="Center"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ExcluirCommand}"
                                                CommandParameter="{Binding .}"/>

                                        </HorizontalStackLayout>

                                        <Label
                                            Grid.Row="1"
                                            Text="{Binding ValorFormatado}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{Binding CorValor}"/>

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding DataHoraFormatada}"
                                            HorizontalOptions="End"
                                            FontSize="11"
                                            TextColor="#5F5F5F"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <Button
                        Text="Adicionar"
                        Margin="14,0"
                        HeightRequest="50"
                        CornerRadius="25"
                        FontAttributes="Bold"
                        TextColor="White"
                        Command="{Binding AdicionarCommand}">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#006260" Offset="0"/>
                                <GradientStop Color="#1B8A86" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>

                    </Button>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <views:CustomTabBar Grid.Row="1"/>

    </Grid>

</ContentPage>
