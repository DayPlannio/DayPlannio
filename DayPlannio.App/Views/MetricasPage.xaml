<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DayPlannio.App.ViewModels"
             xmlns:helpers="clr-namespace:DayPlannio.App.Helpers"
             xmlns:views="clr-namespace:DayPlannio.App.Views"
             x:Class="DayPlannio.App.Views.MetricasPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F2F4F3">

    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0"
                             Spacing="14"
                             Padding="16,16,16,0">

            <Grid
                ColumnDefinitions="Auto,*"
                HeightRequest="34">

                <ImageButton
                    Grid.Column="0"
                    Source="icon_seta_esquerda.png"
                    BackgroundColor="Transparent"
                    WidthRequest="34"
                    HeightRequest="34"
                    Command="{Binding VoltarCommand}"/>

            </Grid>

            <Label Text="Métricas"
                   HorizontalOptions="Center"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#006260"/>

             <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button Text="{Binding Periodos[0]}"
                        Command="{Binding SelecionarPeriodoCommand}"
                        CommandParameter="0"
                        BackgroundColor="#E6F4F3"
                        TextColor="#006260"
                        FontSize="12"
                        CornerRadius="16"
                        HeightRequest="34"
                        Padding="14,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding PeriodoIndice}" Value="0">
                            <Setter Property="BackgroundColor" Value="#006260"/>
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="{Binding Periodos[1]}"
                        Command="{Binding SelecionarPeriodoCommand}"
                        CommandParameter="1"
                        BackgroundColor="#E6F4F3"
                        TextColor="#006260"
                        FontSize="12"
                        CornerRadius="16"
                        HeightRequest="34"
                        Padding="14,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding PeriodoIndice}" Value="1">
                            <Setter Property="BackgroundColor" Value="#006260"/>
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="{Binding Periodos[2]}"
                        Command="{Binding SelecionarPeriodoCommand}"
                        CommandParameter="2"
                        BackgroundColor="#E6F4F3"
                        TextColor="#006260"
                        FontSize="12"
                        CornerRadius="16"
                        HeightRequest="34"
                        Padding="14,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding PeriodoIndice}" Value="2">
                            <Setter Property="BackgroundColor" Value="#006260"/>
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16,16,16,24">

                <Label Text="Resumo Geral"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#1D1D1D"/>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                    <Frame Grid.Column="0" Grid.Row="0" BackgroundColor="White" CornerRadius="16" Padding="14" HasShadow="True" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Atendimentos" FontSize="12" TextColor="#6E7978"/>
                            <Label Text="{Binding Atendimentos}" FontSize="24" FontAttributes="Bold" TextColor="#006260"/>
                            <Label Text="{Binding VariacaoAtendimentos}" FontSize="10" TextColor="{Binding CorVariacaoAtendimentos}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1" Grid.Row="0" BackgroundColor="White" CornerRadius="16" Padding="14" HasShadow="True" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Clientes" FontSize="12" TextColor="#6E7978"/>
                            <Label Text="{Binding Clientes}" FontSize="24" FontAttributes="Bold" TextColor="#006260"/>
                            <Label Text="{Binding VariacaoClientes}" FontSize="10" TextColor="{Binding CorVariacaoClientes}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="0" Grid.Row="1" BackgroundColor="White" CornerRadius="16" Padding="14" HasShadow="True" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tempo Trabalhado" FontSize="12" TextColor="#6E7978"/>
                            <Label Text="em construção" FontSize="10" TextColor="#4DB6AC"/>
                            <Label Text="{Binding TempoTrabalhado}" FontSize="24" FontAttributes="Bold" TextColor="#006260"/>
                            <Label Text="{Binding VariacaoTempo}" FontSize="10" TextColor="{Binding CorVariacaoTempo}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1" Grid.Row="1" BackgroundColor="White" CornerRadius="16" Padding="14" HasShadow="True" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Faturamento" FontSize="12" TextColor="#6E7978"/>
                            <Label Text="{Binding Faturamento}" FontSize="24" FontAttributes="Bold" TextColor="#006260"/>
                            <Label Text="{Binding VariacaoFaturamento}" FontSize="10" TextColor="{Binding CorVariacaoFaturamento}"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <Label Text="Atendimentos por Serviço"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#1D1D1D"/>

                <Frame BackgroundColor="White" CornerRadius="16" Padding="14" HasShadow="True" BorderColor="Transparent">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="180,*" ColumnSpacing="14">

                            <Grid Grid.Column="0" WidthRequest="170" HeightRequest="170">
                                <GraphicsView x:Name="DonutChart" BackgroundColor="Transparent"/>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                    <Label Text="{Binding Atendimentos}" FontSize="26" FontAttributes="Bold" TextColor="#1D1D1D" HorizontalOptions="Center"/>
                                    <Label Text="total" FontSize="11" TextColor="#6E7978" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <CollectionView ItemsSource="{Binding PorServico}" SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8" Padding="0,4">
                                                <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" CornerRadius="3" Color="{Binding Cor}" VerticalOptions="Center"/>
                                                <Label Grid.Column="1" Text="{Binding Servico}" FontSize="12" TextColor="#1D1D1D" VerticalOptions="Center"/>
                                                <Label Grid.Column="2" Text="{Binding QuantidadeTexto}" FontSize="12" TextColor="#006260" FontAttributes="Bold" VerticalOptions="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Label Text="Sem serviços no período."
                                       FontSize="12"
                                       TextColor="#6E7978"
                                       IsVisible="False">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding TemDados}" Value="False">
                                            <Setter Property="IsVisible" Value="True"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>

                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Tempo Médio por Serviço"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#1D1D1D"/>

                <Label Text="Em construção (geofencing). O tempo dos atendimentos é registrado automaticamente com a detecção de entrada e saída, que ainda não está disponível."
                       FontSize="11"
                       LineBreakMode="WordWrap"
                       TextColor="#4DB6AC"/>

                <Frame BackgroundColor="White" CornerRadius="16" Padding="14" HasShadow="True" BorderColor="Transparent">
                    <VerticalStackLayout>
                        <CollectionView ItemsSource="{Binding PorServico}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,6">
                                        <Label Grid.Column="0" Text="{Binding Servico}" FontSize="13" TextColor="#1D1D1D"/>
                                        <Label Grid.Column="1" Text="{Binding TempoMedioTexto}" FontSize="13" TextColor="#006260" FontAttributes="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="Sem dados no período."
                               FontSize="12"
                               TextColor="#6E7978"
                               IsVisible="False">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding TemDados}" Value="False">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Faturamento por Serviço"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#1D1D1D"/>

                <Frame BackgroundColor="White" CornerRadius="16" Padding="14" HasShadow="True" BorderColor="Transparent">
                    <VerticalStackLayout>
                        <CollectionView ItemsSource="{Binding PorServico}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,6">
                                        <Label Grid.Column="0" Text="{Binding Servico}" FontSize="13" TextColor="#1D1D1D"/>
                                        <Label Grid.Column="1" Text="{Binding FaturamentoTexto}" FontSize="13" TextColor="#006260" FontAttributes="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="Sem dados no período."
                               FontSize="12"
                               TextColor="#6E7978"
                               IsVisible="False">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding TemDados}" Value="False">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Maiores Atendimentos"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#1D1D1D"/>

                <Label Text="em construção (geofencing)"
                       FontSize="11"
                       TextColor="#4DB6AC"/>

                <Frame BackgroundColor="White" CornerRadius="16" Padding="14" HasShadow="True" BorderColor="Transparent">
                    <VerticalStackLayout>
                        <CollectionView ItemsSource="{Binding MaioresAtendimentos}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,6">
                                        <Label Grid.Column="0" Text="{Binding Servico}" FontSize="13" TextColor="#1D1D1D"/>
                                        <Label Grid.Column="1" Text="{Binding DuracaoTexto}" FontSize="13" TextColor="#006260" FontAttributes="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="Sem atendimentos no período."
                               FontSize="12"
                               TextColor="#6E7978"
                               IsVisible="False">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding TemDados}" Value="False">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Cancelamentos"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#1D1D1D"/>

                <Frame BackgroundColor="White" CornerRadius="16" Padding="14" HasShadow="True" BorderColor="Transparent">
                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Taxa de cancelamento" FontSize="12" TextColor="#6E7978"/>
                                <Label Text="{Binding TaxaCancelamento}" FontSize="24" FontAttributes="Bold" TextColor="#BA1A1A"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                                <Label Text="Cancelados" FontSize="12" TextColor="#6E7978" HorizontalOptions="End"/>
                                <Label Text="{Binding Cancelamentos}" FontSize="18" FontAttributes="Bold" TextColor="#1D1D1D" HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#E6E9E8"/>

                        <Label FontSize="11" TextColor="#6E7978" LineBreakMode="WordWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Dos "/>
                                    <Span Text="{Binding TotalFinalizados}" FontAttributes="Bold"/>
                                    <Span Text=" atendimentos finalizados no período (concluídos + cancelados), "/>
                                    <Span Text="{Binding Cancelamentos}" FontAttributes="Bold"/>
                                    <Span Text=" foram cancelados."/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="White" CornerRadius="16" Padding="14" HasShadow="True" BorderColor="Transparent">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="Motivos mais citados"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1D1D1D"/>

                        <Label Text="Palavras que mais apareceram nos motivos de cancelamento do período."
                               FontSize="11"
                               TextColor="#6E7978"
                               LineBreakMode="WordWrap"/>

                        <CollectionView ItemsSource="{Binding MotivosCancelamento}" SelectionMode="None" IsVisible="{Binding SemMotivos, Converter={StaticResource InvertedBoolConverter}}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,6">
                                        <Label Grid.Column="0" Text="{Binding Palavra}" FontSize="13" TextColor="#1D1D1D" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding PercentualTexto}" FontSize="13" TextColor="#BA1A1A" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Text="Nenhum cancelamento registrado no período."
                               FontSize="12"
                               TextColor="#6E7978"
                               IsVisible="{Binding SemCancelamentos}"/>

                        <Label Text="Os cancelamentos não têm motivo informado."
                               FontSize="12"
                               TextColor="#6E7978"
                               IsVisible="{Binding SemMotivos}"/>

                    </VerticalStackLayout>
                </Frame>

                <Label Text="Resumo de Tempo"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#1D1D1D"/>

                <Label Text="O tempo de cada atendimento é registrado automaticamente pela detecção de entrada e saída no local do serviço (geofencing), que ainda não está disponível."
                       FontSize="11"
                       LineBreakMode="WordWrap"
                       TextColor="#4DB6AC"/>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                    <Frame Grid.Column="0" Grid.Row="0" BackgroundColor="White" CornerRadius="16" Padding="12" HasShadow="True" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Maior atendimento" FontSize="11" TextColor="#6E7978"/>
                            <Label Text="{Binding ResumoMaior}" FontSize="18" FontAttributes="Bold" TextColor="#1D1D1D"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1" Grid.Row="0" BackgroundColor="White" CornerRadius="16" Padding="12" HasShadow="True" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Menor atendimento" FontSize="11" TextColor="#6E7978"/>
                            <Label Text="{Binding ResumoMenor}" FontSize="18" FontAttributes="Bold" TextColor="#1D1D1D"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="0" Grid.Row="1" BackgroundColor="White" CornerRadius="16" Padding="12" HasShadow="True" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Tempo médio" FontSize="11" TextColor="#6E7978"/>
                            <Label Text="{Binding ResumoMedio}" FontSize="18" FontAttributes="Bold" TextColor="#1D1D1D"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1" Grid.Row="1" BackgroundColor="White" CornerRadius="16" Padding="12" HasShadow="True" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Tempo total" FontSize="11" TextColor="#6E7978"/>
                            <Label Text="{Binding ResumoTotal}" FontSize="18" FontAttributes="Bold" TextColor="#1D1D1D"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <Label Text="Nenhum atendimento concluído no período."
                       FontSize="13"
                       TextColor="#6E7978"
                       HorizontalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding TemDados}" Value="True">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>

        <views:CustomTabBar Grid.Row="2" x:Name="TabBar"/>

    </Grid>

</ContentPage>
