{
  "name": "pi-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Testes Jest, Supertest e Cypress do DayPlannio com relatório HTML unificado",
  "scripts": {
    "test:jest": "jest tests/unit --runInBand",
    "test:supertest": "jest tests/api --runInBand",
    "test:cypress": "cypress run",
    "cypress:open": "cypress open",
    "test": "node scripts/run-tests.js"
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000
  }
}
