@model DayPlannio.Web.Models.TrocarSenhaViewModel

@{
    ViewData["Title"] = "Primeiro acesso";
    ViewData["SemTopBar"] = true;
    ViewData["SemRodape"] = true;
}

<div class="auth-wrap">
    <div class="auth-card">
        <img src="~/logo.png" class="login-logo" alt="DayPlannio" />
        <p class="auth-subtitle">Este é seu primeiro acesso. Defina uma nova senha.</p>

        <form method="post" asp-action="TrocarSenha">
            <div class="mb-2">
                <label class="form-label">E-mail</label>
                <input class="form-control" value="@Model.Email" disabled />
            </div>
            <div class="mb-3">
                <label asp-for="SenhaAtual" class="form-label">Senha provisória <span class="obrigatorio">*</span></label>
                <div class="senha-campo">
                    <input asp-for="SenhaAtual" type="password" class="form-control senha-input" id="senhaAtualT" />
                    <button type="button" class="btn-olho-interno" data-eyetoggle="senhaAtualT" aria-label="Mostrar/ocultar senha">
                        <img src="~/icon_olho_aberto.png" alt="Mostrar/ocultar senha" />
                    </button>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="SenhaNova" class="form-label">Nova senha <span class="obrigatorio">*</span></label>
                <div class="senha-campo">
                    <input asp-for="SenhaNova" type="password" class="form-control senha-input" id="senhaNovaT" data-req-input />
                    <button type="button" class="btn-olho-interno" data-eyetoggle="senhaNovaT" aria-label="Mostrar/ocultar senha">
                        <img src="~/icon_olho_aberto.png" alt="Mostrar/ocultar senha" />
                    </button>
                </div>
                <ul class="senha-lista" data-req-lista>
                    <li data-req="tamanho"><span class="ponto">&#9679;</span> Mínimo 6 caracteres</li>
                    <li data-req="maiusculo"><span class="ponto">&#9679;</span> Uma letra maiúscula</li>
                    <li data-req="minusculo"><span class="ponto">&#9679;</span> Uma letra minúscula</li>
                    <li data-req="especial"><span class="ponto">&#9679;</span> Um caractere especial</li>
                    <li data-req="numero"><span class="ponto">&#9679;</span> Um número</li>
                </ul>
                <div class="form-text text-danger" id="avisoMesmaSenhaT" hidden>A nova senha não pode ser igual à senha atual.</div>
            </div>
            <div class="mb-3">
                <label asp-for="SenhaNovaConfirmacao" class="form-label">Confirmar nova senha <span class="obrigatorio">*</span></label>
                <div class="senha-campo">
                    <input asp-for="SenhaNovaConfirmacao" type="password" class="form-control senha-input" id="senhaConfirmarT" />
                    <button type="button" class="btn-olho-interno" data-eyetoggle="senhaConfirmarT" aria-label="Mostrar/ocultar senha">
                        <img src="~/icon_olho_aberto.png" alt="Mostrar/ocultar senha" />
                    </button>
                </div>
                <div class="form-text text-danger" id="avisoSenhaT" hidden>As senhas não coincidem.</div>
            </div>
            <div class="mb-3">
                <label asp-for="EmailSecundario" class="form-label">E-mail de recuperação <span class="obrigatorio">*</span></label>
                <input asp-for="EmailSecundario" type="email" class="form-control" placeholder="onde deseja receber códigos" />
                <div class="form-text">Se esquecer a senha, o código de recuperação será enviado para este e-mail.</div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Erro))
            {
                <div class="alert alert-danger">@Model.Erro</div>
            }
            @if (!string.IsNullOrEmpty(Model.Mensagem))
            {
                <div class="alert alert-success">@Model.Mensagem</div>
            }

            <div class="obrigatorio-texto">Campos com <span class="obrigatorio">*</span> são obrigatórios</div>
            <button type="submit" class="btn btn-dp w-100">Confirmar</button>
        </form>

        <script>
            (function () {
                document.querySelectorAll('[data-eyetoggle]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var alvo = document.getElementById(btn.getAttribute('data-eyetoggle'));
                        if (!alvo) return;
                        alvo.type = alvo.type === 'text' ? 'password' : 'text';
                        var img = btn.querySelector('img');
                        if (img) {
                            img.src = alvo.type === 'password'
                                ? img.src.replace('fechado', 'aberto')
                                : img.src.replace('aberto', 'fechado');
                        }
                    });
                });

                document.querySelectorAll('[data-req-input]').forEach(function (input) {
                    function verificar() {
                        var v = input.value || '';
                        var wrapper = input.closest('.mb-3');
                        if (!wrapper) return;
                        var lista = wrapper.querySelector('[data-req-lista]');
                        if (!lista) return;
                        lista.querySelectorAll('[data-req]').forEach(function (item) {
                            var tipo = item.getAttribute('data-req');
                            var ok = false;
                            if (tipo === 'tamanho') ok = v.length >= 6;
                            else if (tipo === 'maiusculo') ok = /[A-Z]/.test(v);
                            else if (tipo === 'minusculo') ok = /[a-z]/.test(v);
                            else if (tipo === 'numero') ok = /[0-9]/.test(v);
                            else if (tipo === 'especial') ok = /[^A-Za-z0-9]/.test(v);
                            item.classList.toggle('ok', ok);
                        });
                    }
                    input.addEventListener('input', verificar);
                    verificar();
                });
            })();
            (function () {
                var nova = document.getElementById('senhaNovaT');
                var confirmacao = document.getElementById('senhaConfirmarT');
                var aviso = document.getElementById('avisoSenhaT');
                if (!nova || !confirmacao || !aviso) return;

                function comparar() {
                    aviso.hidden = !(confirmacao.value.length > 0 && nova.value !== confirmacao.value);
                }

                nova.addEventListener('input', comparar);
                confirmacao.addEventListener('input', comparar);
                comparar();
            })();
            (function () {
                var atual = document.getElementById('senhaAtualT');
                var nova = document.getElementById('senhaNovaT');
                var aviso = document.getElementById('avisoMesmaSenhaT');
                if (!atual || !nova || !aviso) return;

                function comparar() {
                    aviso.hidden = !(nova.value.length > 0 && nova.value === atual.value);
                }

                atual.addEventListener('input', comparar);
                nova.addEventListener('input', comparar);
                comparar();
            })();
        </script>
    </div>
</div>

