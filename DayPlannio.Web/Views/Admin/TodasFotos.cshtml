@model DayPlannio.Web.Models.AdminPainelViewModel

@{
    ViewData["Title"] = "Todas as fotos";
    ViewData["SemTopBar"] = true;
    ViewData["SemRodape"] = true;
}

<div class="container" style="max-width: 1200px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2 metri-top">
        <img src="~/logo.png" class="metri-logo" alt="DayPlannio" />
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="Logout" class="btn btn-sair">Sair</a>
        </div>
    </div>
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div class="d-flex align-items-center gap-2">
            <h2 class="page-title mb-0">Todas as fotos</h2>
            @if (Model.FotosPendentes.Count > 0)
            {
                <span class="badge badge-status pendente">@Model.FotosPendentes.Count</span>
            }
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="Fotos" class="btn btn-dp-outline">Voltar</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensagem))
    {
        <div class="alert alert-success">@Model.Mensagem</div>
    }

    <div class="dp-card p-3 mb-4">
        @if (Model.FotosPendentes.Count > 0)
        {
            <p class="text-muted mb-3">@Model.FotosPendentes.Count foto(s) aguardando aprovação</p>
            <div class="row g-3">
                @foreach (var foto in Model.FotosPendentes)
                {
                    @await Html.PartialAsync("_CardFoto", (foto, "TodasFotos"))
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <span class="empty-icon"><svg class="empty-svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="12" cy="13" r="3.5"/></svg></span>
                <p class="empty-titulo">Nenhuma foto pendente</p>
                <p class="empty-texto">Todas as fotos foram revisadas.</p>
            </div>
        }
    </div>
</div>