@model (DayPlannio.Web.Models.AdminFotoItem Foto, string Origem)

<div class="col-12 col-sm-6 col-md-4 col-lg-3">
    <div class="dp-card p-2 h-100 d-flex flex-column">
        <div style="aspect-ratio:1; overflow:hidden; border-radius:12px; background:#f0f0f0;">
            <img src="@Model.Foto.Url" alt="@Model.Foto.Descricao"
                 style="width:100%; height:100%; object-fit:cover;" />
        </div>
        <div class="mt-2 flex-grow-1">
            <p class="mb-1" style="font-size:.85rem; font-weight:600;">@Model.Foto.Prestador</p>
            @if (!string.IsNullOrEmpty(Model.Foto.Servico))
            {
                <p class="mb-1" style="font-size:.8rem; color:var(--dp-muted);">@Model.Foto.Servico</p>
            }
            @if (!string.IsNullOrEmpty(Model.Foto.Descricao))
            {
                <p class="mb-1" style="font-size:.8rem; color:var(--dp-muted);">@Model.Foto.Descricao</p>
            }
            <p class="mb-2" style="font-size:.75rem; color:#aaa;">@FormatHelper.FormatarDataLocal(Model.Foto.DataUpload)</p>
            @if (Model.Foto.Publica)
            {
                <span class="badge badge-status concluido mb-2">Portfólio</span>
            }
        </div>
        <div class="d-flex gap-2">
            <form asp-controller="Admin" asp-action="AprovarFoto" method="post" class="flex-grow-1">
                <input type="hidden" name="id" value="@Model.Foto.Id" />
                <input type="hidden" name="origem" value="@Model.Origem" />
                <button type="submit" class="btn btn-sm w-100"
                        style="background:#2E7D32; color:white; border:none; border-radius:8px; padding:6px 0;">
                    Aprovar
                </button>
            </form>
            <form asp-controller="Admin" asp-action="RejeitarFoto" method="post" class="flex-grow-1"
                  onsubmit="return confirm('Rejeitar e excluir esta foto?')">
                <input type="hidden" name="id" value="@Model.Foto.Id" />
                <input type="hidden" name="origem" value="@Model.Origem" />
                <button type="submit" class="btn btn-sm w-100"
                        style="background:#BA1A1A; color:white; border:none; border-radius:8px; padding:6px 0;">
                    Rejeitar
                </button>
            </form>
        </div>
    </div>
</div>
