@model DayPlannio.Web.Models.MetricasViewModel

@{
    ViewData["Title"] = "Métricas do Cliente";
    ViewData["SemTopBar"] = true;
    ViewData["SemRodape"] = true;
    string[] Periodos = { "mensal", "semanal", "diario" };
    string[] Rotulos = { "Este mês", "Esta semana", "Hoje" };
}

<div class="container" style="max-width: 980px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2 metri-top">
        <img src="~/logo.png" class="metri-logo" alt="DayPlannio" />
        <div class="d-flex gap-2">
            <a asp-controller="Account" asp-action="Perfil" class="btn btn-dp-outline">Meu Perfil</a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-sair">Sair</a>
        </div>
    </div>
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h2 class="page-title mb-0">Meus Indicadores</h2>
        <div class="d-flex gap-2">
            <div class="btn-group" role="group">
                @for (int i = 0; i < Periodos.Length; i++)
                {
                    var ativo = Periodos[i] == Model.Periodo;
                    <a asp-controller="Dashboard" asp-action="Metricas" asp-route-periodo="@Periodos[i]"
                       class="btn btn-dp-period @(ativo ? "active" : "")">@Rotulos[i]</a>
                }
            </div>
        </div>
    </div>

    @if (Model.Metricas is null)
    {
        <div class="dp-card p-4 text-center">
            @if (!string.IsNullOrWhiteSpace(Model.ErroMensagem))
            {
                <div class="alert alert-warning mb-0">@Model.ErroMensagem</div>
            }
            else
            {
                <div class="alert alert-warning mb-0">Nenhum dado encontrado para este período.</div>
            }
        </div>
    }

    @if (Model.Metricas != null)
    {
        <div class="d-flex align-items-center section-title"><span class="section-icon">&#9636;</span> Resumo Geral</div>
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-label">Total de serviços</div>
                    <div class="stat-value">@Model.Metricas.ResumoGeral.TotalServicos</div>
                    <div class="stat-delta @(Model.Metricas.Variacoes.Atendimentos > 0 ? "up" : "")">@Model.VariacaoAtendimentos</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-label">Tempo total <span class="em-construcao">em construção</span></div>
                    <div class="stat-value">@Model.TempoTotalTexto</div>
                    <div class="stat-delta @(Model.Metricas.Variacoes.Tempo > 0 ? "up" : "")">@Model.VariacaoTempo</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-label">Tempo médio <span class="em-construcao">em construção</span></div>
                    <div class="stat-value">@Model.TempoMedioTexto</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-label">Valor total investido</div>
                    <div class="stat-value">@Model.Metricas.ResumoGeral.ValorTotal.ToString("C")</div>
                    <div class="stat-delta @(Model.Metricas.Variacoes.Valor > 0 ? "up" : "")">@Model.VariacaoValor</div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center section-title"><span class="section-icon">&#9679;</span> Serviços por Categoria</div>
        <div class="dp-card p-3 mb-4">
            @if (Model.Metricas != null && Model.Metricas.ServicosPorCategoria.Any(c => c.Quantidade > 0))
            {
                <div class="row align-items-center">
                    <div class="col-md-5">
                        <canvas id="graficoCategoria" height="220"></canvas>
                    </div>
                    <div class="col-md-7">
                        <table class="table table-sm table-dp align-middle mb-0">
                            <thead>
                                <tr><th>Categoria</th><th>Qtd</th><th class="text-end">Valor</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Metricas.ServicosPorCategoria)
                                {
                                    <tr>
                                        <td>@c.Categoria</td>
                                        <td><span class="badge-status concluido">@c.Quantidade</span></td>
                                        <td class="text-end">@c.Valor.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <span class="empty-icon"><svg class="empty-svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M21 12a9 9 0 1 1-9-9" /><path d="M12 3a9 9 0 0 1 9 9h-9z" /></svg></span>
                    <p class="empty-titulo">Nenhum serviço realizado no período</p>
                    <p class="empty-texto">Os serviços por categoria aparecerão aqui quando houver atendimentos concluídos.</p>
                </div>
            }
        </div>

        <div class="d-flex align-items-center justify-content-between section-title">
            <div class="d-flex align-items-center gap-2"><span class="section-icon">&#9776;</span> Histórico de Atendimentos</div>
            @if (Model.Metricas != null && Model.Metricas.Historico.Count > 5)
            {
                <a asp-controller="Dashboard" asp-action="HistoricoCliente" class="btn btn-dp-outline btn-sm">Ver todos (@Model.Metricas.Historico.Count)</a>
            }
        </div>
        <div class="dp-card p-3 mb-4">
            <div class="table-responsive">
                <table class="table table-sm table-dp align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Serviço</th><th>Data</th><th>Profissional</th>
                            <th>Início</th><th>Término</th><th>Duração <span class="em-construcao">em construção</span></th><th class="text-end">Preço</th><th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Metricas.Historico.Take(5))
                        {
                            <tr>
                                <td>@h.Servico</td>
                                <td>@h.Data.ToString("dd/MM/yyyy")</td>
                                <td>@h.Profissional</td>
                                <td>@(h.Inicio?.ToString("HH:mm") ?? "-")</td>
                                <td>@(h.Fim?.ToString("HH:mm") ?? "-")</td>
                                <td>@(h.DuracaoMinutos.HasValue ? $"{Math.Round(h.DuracaoMinutos.Value)}min" : "-")</td>
                                <td class="text-end">@(h.Valor.HasValue ? h.Valor.Value.ToString("C") : "-")</td>
                                <td><span class="badge-status concluido">@h.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="row g-3 mb-4 d-flex align-items-stretch">
            <div class="col-md-6 d-flex">
                <div class="dp-card p-3 w-100 d-flex flex-column">
                    <div class="d-flex align-items-center section-title mb-2"><span class="section-icon">&#9201;</span> Tempo Médio por Serviço <span class="em-construcao">em construção</span></div>
                    @if (Model.Metricas != null && Model.Metricas.TempoMedioPorServico.Count > 0)
                    {
                        <ul class="lista-valores flex-grow-1">
                            @foreach (var s in Model.Metricas.TempoMedioPorServico)
                            {
                                <li>
                                    <span class="lista-label">@s.Categoria</span>
                                    <span class="lista-valor">@Model.FormatarMinutos(s.TempoMedioMinutos)</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="empty-state flex-grow-1">
                            <span class="empty-icon"><svg class="empty-svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
                            <p class="empty-titulo">Em construção (geofencing)</p>
                            <p class="empty-texto">O tempo dos atendimentos é registrado automaticamente com a detecção de entrada e saída, que está em construção. Em breve os tempos médios por serviço aparecem aqui.</p>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-6 d-flex">
                <div class="dp-card p-3 w-100 d-flex flex-column">
                    <div class="d-flex align-items-center section-title mb-2"><span class="section-icon">&#9783;</span> Investimento por Serviço</div>
                    @if (Model.Metricas != null && Model.Metricas.InvestimentoPorServico.Count > 0)
                    {
                        <ul class="lista-valores flex-grow-1">
                            @foreach (var s in Model.Metricas.InvestimentoPorServico)
                            {
                                <li>
                                    <span class="lista-label">@s.Categoria</span>
                                    <span class="lista-valor">@Model.FormatarValor(s.Valor)</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="empty-state flex-grow-1">
                            <span class="empty-icon"><svg class="empty-svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M14.5 9.3c-.4-.8-1.3-1.3-2.5-1.3-1.5 0-2.5.8-2.5 1.9 0 2.6 5 1.4 5 4.1 0 1.1-1 1.9-2.5 1.9-1.2 0-2.1-.5-2.6-1.4M12 6.5V8m0 8v1.5"/></svg></span>
                            <p class="empty-titulo">Sem investimento no período</p>
                            <p class="empty-texto">Os valores por serviço aparecerão aqui quando houver atendimentos concluídos.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center section-title"><span class="section-icon">&#9650;</span> Evolução dos Atendimentos</div>
        <div class="dp-card p-3 mb-4">
            @if (Model.Metricas != null && Model.Metricas.Evolucao.Any(e => e.Quantidade > 0))
            {
                <canvas id="graficoEvolucao" height="200"></canvas>
            }
            else
            {
                <div class="empty-state">
                    <span class="empty-icon"><svg class="empty-svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20h18"/><path d="M4 15l4-4 4 3 6-7"/></svg></span>
                    <p class="empty-titulo">Sem evolução no período</p>
                    <p class="empty-texto">Os atendimentos concluídos aparecerão aqui quando houver dados.</p>
                </div>
            }
        </div>

        <div class="d-flex align-items-center section-title"><span class="section-icon">&#9201;</span> Resumo de Tempo <span class="em-construcao">em construção</span></div>
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="stat-card time-card">
                    <div class="stat-label">Maior atendimento <span class="em-construcao">em construção</span></div>
                    <div class="stat-value">@Model.ResumoMaior</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card time-card">
                    <div class="stat-label">Menor atendimento <span class="em-construcao">em construção</span></div>
                    <div class="stat-value">@Model.ResumoMenor</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card time-card">
                    <div class="stat-label">Tempo médio <span class="em-construcao">em construção</span></div>
                    <div class="stat-value">@Model.ResumoMedio</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card time-card">
                    <div class="stat-label">Tempo total <span class="em-construcao">em construção</span></div>
                    <div class="stat-value">@Model.ResumoTotal</div>
                </div>
            </div>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    const paleta = ['#006260', '#1E7C7A', '#4DB6AC', '#80CBC4', '#FF8A65', '#FFB74D', '#9575CD'];
    Chart.defaults.color = '#6E7978';

    @if (Model.Metricas != null)
    {
        <text>
        @if (Model.Metricas.ServicosPorCategoria.Any(c => c.Quantidade > 0))
        {
            <text>
        new Chart(document.getElementById('graficoCategoria'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Model.CategoriaLabelsJson),
                datasets: [{
                    data: @Html.Raw(Model.CategoriaValoresJson),
                    backgroundColor: paleta,
                    borderWidth: 2,
                    borderColor: '#fff',
                    hoverOffset: 4
                }]
            },
            options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { usePointStyle: true } } } }
        });
            </text>
        }

        @if (Model.Metricas.Evolucao.Any(e => e.Quantidade > 0))
        {
            <text>
        new Chart(document.getElementById('graficoEvolucao'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Model.EvolucaoLabelsJson),
                datasets: [{ label: 'Atendimentos', data: @Html.Raw(Model.EvolucaoValoresJson), borderColor: '#006260', backgroundColor: 'rgba(0,98,96,0.12)', fill: true, tension: 0.35, pointBackgroundColor: '#006260' }]
            },
            options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
        });
            </text>
        }
        </text>
    }
</script>
