# DayPlannio - variaveis de ambiente da VM (NAO commitar este arquivo).
# Copie para "vm.env" e preencha. IMPORTANTE: coloque os valores entre aspas.
# Use aspas SIMPLES ('...') nos segredos que tenham "$", pois dentro de aspas
# duplas o shell tenta expandir o "$".

# --- Repositorio do projeto ---
# Repo PUBLICO (padrao): clona por https, SEM token/credencial.
REPO_URL="https://github.com/DayPlannio/DayPlannio.git"
#
# Repo PRIVADO (opcional): descomente as duas linhas e configure a deploy key.
# REPO_URL="git@github.com:DayPlannio/DayPlannio.git"
# GIT_SSH_KEY="/root/.ssh/deploy_dayplannio"
#
# Se o codigo ja foi enviado para /opt/dayplannio/src (ex.: por zip/scp), use:
# SKIP_GIT=1

# --- MongoDB Atlas ---
MONGO_CONNECTION_STRING="mongodb+srv://usuario:senha@cluster.mongodb.net/?appName=DayPlannio"
MONGO_DATABASE="dbDayPlannio"

# --- Chave compartilhada entre Web e API (o App tambem pode usar) ---
# Gere uma chave sua, por exemplo: openssl rand -hex 24
WEB_API_KEY="COLOQUE_UMA_CHAVE_FORTE_AQUI"

# --- Azure Blob Storage ---
AZURE_BLOB_CONNECTION="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
BLOB_CONTAINER="fotos"

# --- E-mail (Gmail) ---
GMAIL_USER="suporte.dayplannio@gmail.com"
GMAIL_PASSWORD="xxxx xxxx xxxx xxxx"

# --- Usuario administrador criado automaticamente no 1o start da API ---
ADMIN_EMAIL="admin@dayplannio.com"
ADMIN_SENHA="TrocarEstaSenha123!"
ADMIN_NOME="Administrador"

# --- Localizacao (geofencing) e fuso horario ---
# Opcional: se omitir, valem os valores abaixo (padroes de producao).
GEOFENCING_CONFIRMACAO_MINUTOS="5"
GEOFENCING_TOLERANCIA_SAIDA_METROS="15"
GEOFENCING_TOLERANCIA_PAUSA_MINUTOS="30"
GEOFENCING_JANELA_HORAS="24"
GEOFENCING_PRECISAO_MAXIMA_METROS="0"
VM_TIMEZONE="America/Sao_Paulo"
